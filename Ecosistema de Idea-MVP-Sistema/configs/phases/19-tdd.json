          "selected": false
        },
        {
          "value": "opt_b",
          "label": "Se reescribe desde cero sin tests previos",
          "disabled": false,
          "selected": false
        },
        {
          "value": "opt_c",
          "label": "No se toca legacy — solo código nuevo con TDD",
          "disabled": false,
          "selected": false
        },
        {
          "value": "opt_d",
          "label": "No hay legacy en MVP",
          "disabled": false,
          "selected": false
        }
