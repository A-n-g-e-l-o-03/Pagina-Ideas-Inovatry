        {
          "value": "opt_b",
          "label": "Rolling update estándar sin métricas",
          "disabled": false,
          "selected": false
        },
        {
          "value": "opt_c",
          "label": "Recreate — downtime aceptado",
          "disabled": false,
          "selected": false
        },
        {
          "value": "opt_d",
