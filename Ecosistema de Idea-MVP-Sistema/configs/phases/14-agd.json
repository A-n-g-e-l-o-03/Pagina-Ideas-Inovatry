          "selected": false
        },
        {
          "value": "opt_b",
          "label": "Solo lenguaje sin patrones",
          "disabled": false,
          "selected": false
        },
        {
          "value": "opt_c",
          "label": "Stack genérico — \"que genere cualquier cosa\"",
          "disabled": false,
          "selected": false
        },
        {
          "value": "opt_d",
          "label": "No definido",
          "disabled": false,
          "selected": false
        }
      ]
    },
    {
