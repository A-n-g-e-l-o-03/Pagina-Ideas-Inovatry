          "disabled": false,
          "selected": false
        },
        {
          "value": "opt_c",
          "label": "Solo archivo actual sin cross-file",
          "disabled": false,
          "selected": false
        },
        {
          "value": "opt_d",
          "label": "No definido",
          "disabled": false,
          "selected": false
        }
      ]
