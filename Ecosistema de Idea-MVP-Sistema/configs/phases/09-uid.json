  "hero": {
    "title": "UID — Web",
    "description": "El UID (UI Design Document) define cómo el usuario ve y toca el MVP. No es \"hacerlo lindo\" — es usabilidad, accesibilidad, performance percibida y consistencia. Se genera en fase design SDD y debe estar conectado al PRD Usuario (02-a) y al journey mapeado.",
    "badge": "5 preguntas"
  },
  "form": {
    "title": "UID — Web",
    "subtitle": "5 preguntas — Marca con * las obligatorias."
  },
  "sections": {
    "web": {
      "title": "1 · Web",
      "description": "¿Rápida, Accesible, Responsive?"
    }
  },
  "fields": [
    {
      "id": "p01",
      "sectionId": "web",
      "label": "P1. ¿Qué stack de frontend usa el MVP?",
