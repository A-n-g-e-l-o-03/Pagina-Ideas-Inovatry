      "required": true,
      "fullWidth": true,
      "placeholder": "Mapeá bounded contexts a dominios de negocio: ¿cuántos contextos, cómo se..."
    },
    {
      "id": "p05",
      "sectionId": "arquitectura",
      "label": "P5. ¿Qué principios de diseño rigen el MVP?",
      "type": "radio",
      "required": true,
      "options": [
        {
          "value": "opt_a",
          "label": "SOLID + DDD + hexagonal/clean",
          "disabled": false,
          "selected": false
        },
        {
          "value": "opt_b",
          "label": "CQRS/ES + event-first",
          "disabled": false,
          "selected": false
        },
        {
          "value": "opt_c",
          "label": "API-first + contract-first",
          "disabled": false,
          "selected": false
        },
        {
          "value": "opt_d",
          "label": "Sin principios explícitos — \"lo que salga\"",
          "disabled": false,
          "selected": false
        },
        {
          "value": "opt_e",
          "label": "Combinación justificada",
          "disabled": false,
          "selected": false
        }
      ]
    }
  ],
