          "label": "Solo changelog",
          "disabled": false,
          "selected": false
        },
        {
          "value": "opt_c",
          "label": "Solo commit message",
          "disabled": false,
          "selected": false
        },
        {
          "value": "opt_d",
          "label": "No se comunica",
          "disabled": false,
          "selected": false
        }
      ]
    },
    {
      "id": "p04",
      "sectionId": "estandar",
