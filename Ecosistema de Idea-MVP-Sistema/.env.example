# Discord Webhooks por Phase Group (reemplazar con URLs reales)
# Obtén estas URLs creando webhooks en tu servidor de Discord
# Configuración: Server Settings → Integrations → Webhooks → New Webhook

# Grupo IDD: 00-idea, 01-idd
WEBHOOK_IDD=https://discord.com/api/webhooks/REEMPLAZAR_CON_TU_WEBHOOK_IDD

# Grupo PRD-BRD: 02-prd, 03-brd
WEBHOOK_PRD_BRD=https://discord.com/api/webhooks/REEMPLAZAR_CON_TU_WEBHOOK_PRD_BRD

# Grupo RDD-DMD: 04-rdd, 05-dmd, 06-design
WEBHOOK_RDD_DMD=https://discord.com/api/webhooks/REEMPLAZAR_CON_TU_WEBHOOK_RDD_DMD

# Grupo DESIGN: 07-sad, 08-aad, 09-uid
WEBHOOK_DESIGN=https://discord.com/api/webhooks/REEMPLAZAR_CON_TU_WEBHOOK_DESIGN

# Grupo DBD-API-UID: 10-dbd, 11-api, 12-uid
WEBHOOK_DB_API_UID=https://discord.com/api/webhooks/REEMPLAZAR_CON_TU_WEBHOOK_DB_API_UID

# Grupo SECURITY: 13-srd, 14-agd
WEBHOOK_SECURITY=https://discord.com/api/webhooks/REEMPLAZAR_CON_TU_WEBHOOK_SECURITY

# Grupo AGENTS: 15-aad, 16-aid
