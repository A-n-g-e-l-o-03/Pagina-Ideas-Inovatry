# Grupo DEPLOY-OPS: 23-dep, 24-mdd
WEBHOOK_DEPLOY_OPS=https://discord.com/api/webhooks/REEMPLAZAR_CON_TU_WEBHOOK_DEPLOY_OPS

# Grupo EVOLUTION-COGNITIVE: 25-aed, 26-chd, 27-ced, 28-cca
WEBHOOK_EVOLUTION=https://discord.com/api/webhooks/REEMPLAZAR_CON_TU_WEBHOOK_EVOLUTION